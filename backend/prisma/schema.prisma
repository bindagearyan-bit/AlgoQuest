datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Tier {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SublevelType {
  THEORETICAL
  HYBRID
  CODE_BASED
}

enum League {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum StageType {
  THEORY
  VISUALIZATION
  DRY_RUN
  GUIDED_CODE
  EASY_PROBLEM
  MEDIUM_PROBLEM
  QUIZ
  BOSS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  BOSS
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  username        String            @unique
  passwordHash    String
  avatar          String            @default("default_avatar.png")
  xp              Int               @default(0)
  gems            Int               @default(100)
  hearts          Int               @default(5)
  maxHearts       Int               @default(5)
  streakCount     Int               @default(0)
  longestStreak   Int               @default(0)
  lastActiveDate  DateTime?
  selectedLevel   SkillLevel        @default(BEGINNER)
  currentLeague   League            @default(BRONZE)
  oauthProvider   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  progress        UserProgress[]
  submissions     Submission[]
  achievements    UserAchievement[]
  quizAttempts    QuizAttempt[]
  userBadges          UserBadge[]
  dailyEscapeStreak   Int               @default(0)
  longestEscapeStreak Int               @default(0)
  lastEscapeDate      String?
  dailyEscapeRuns     DailyEscapeRun[]

  @@index([email])
  @@index([xp])
}

model Level {
  id         Int        @id @default(autoincrement())
  title      String
  orderIndex Int        @unique
  icon       String
  sublevels  Sublevel[]
}

model Sublevel {
  id                     Int            @id @default(autoincrement())
  levelId                Int
  title                  String
  orderIndex             Int
  tier                   Tier           @default(BEGINNER)
  sublevelType           SublevelType   @default(CODE_BASED)
  prerequisiteSublevelId Int?
  level                  Level          @relation(fields: [levelId], references: [id], onDelete: Cascade)
  stages                 Stage[]
  problems               Problem[]
  userProgress           UserProgress[]
  badge                  Badge?

  @@index([levelId, orderIndex])
}

model Stage {
  id          Int       @id @default(autoincrement())
  sublevelId  Int
  stageNumber Int
  stageType   StageType
  title       String
  contentJson Json
  sublevel    Sublevel  @relation(fields: [sublevelId], references: [id], onDelete: Cascade)

  @@unique([sublevelId, stageNumber])
}

model Problem {
  id          Int          @id @default(autoincrement())
  sublevelId  Int
  title       String
  description String
  difficulty  Difficulty
  xpReward    Int          @default(30)
  starterCode Json
  sublevel    Sublevel     @relation(fields: [sublevelId], references: [id], onDelete: Cascade)
  testCases   TestCase[]
  submissions Submission[]
}

model TestCase {
  id             Int     @id @default(autoincrement())
  problemId      Int
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id              String   @id @default(uuid())
  userId          String
  sublevelId      Int
  currentStage    Int      @default(1)
  isCompleted     Boolean  @default(false)
  confidenceScore Int      @default(100)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sublevel        Sublevel @relation(fields: [sublevelId], references: [id], onDelete: Cascade)

  @@unique([userId, sublevelId])
}

model Badge {
  id          Int         @id @default(autoincrement())
  sublevelId  Int         @unique
  title       String
  description String
  iconSvg     String
  tier        Tier
  xpReward    Int         @default(500)
  sublevel    Sublevel    @relation(fields: [sublevelId], references: [id], onDelete: Cascade)
  userBadges  UserBadge[]
}

model UserBadge {
  id               String   @id @default(uuid())
  userId           String
  badgeId          Int
  earnedAt         DateTime @default(now())
  score            Int      @default(100)
  timeTakenMinutes Int      @default(15)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge            Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Submission {
  id        String   @id @default(uuid())
  userId    String
  problemId Int
  language  String
  code      String
  status    String
  runtimeMs Int?
  memoryKb  Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, problemId])
}

model UserAchievement {
  id          String   @id @default(uuid())
  userId      String
  achievement String
  unlockedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievement])
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  quizId      Int
  score       Int
  isPassed    Boolean
  attemptedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyEscapeRun {
  id             String   @id @default(uuid())
  userId         String
  dateString     String   // UTC YYYY-MM-DD
  timeElapsed    Int      // in seconds
  livesRemaining Int      // 1 to 5
  isFlawless     Boolean  @default(false)
  isPractice     Boolean  @default(false)
  xpEarned       Int      @default(0)
  roomsCleared   Int      @default(10)
  completedAt    DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dateString, timeElapsed])
  @@index([userId, dateString])
}
